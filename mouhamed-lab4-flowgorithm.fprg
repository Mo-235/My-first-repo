<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="mhddi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-04 02:51:46 PM"/>
        <attribute name="created" value="bWhkZGk7REVTS1RPUC1CN0c2ODRIOzIwMjYtMTAtMDQ7MTI6MTA6NDggQU07Mjc4Nw=="/>
        <attribute name="edited" value="bWhkZGk7REVTS1RPUC1CN0c2ODRIOzIwMjYtMTAtMDQ7MDI6NTE6NDYgUE07MTsyOTEy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Mouhamed Diallo, 10/03/2026 Flowgorithm program that ask a user for their annual IRA contribution, interest rate, and time period. And that calculate the value of the IRA every year."/>
            <declare name="year" type="Integer" array="False" size=""/>
            <declare name="InterestRate" type="Real" array="False" size=""/>
            <declare name="AnnualContribution" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <declare name="years" type="Integer" array="False" size=""/>
            <output expression="&quot; Enter # of years for IRA &quot;" newline="True"/>
            <input variable="years"/>
            <output expression="&quot; Enter interest rate&quot;" newline="True"/>
            <input variable="InterestRate"/>
            <output expression="&quot; Enter annual contribution &quot;" newline="True"/>
            <input variable="AnnualContribution"/>
            <assign variable="total" expression="0"/>
            <assign variable="InterestRate" expression="InterestRate / 100"/>
            <for variable="year" start="1" end="years" direction="inc" step="1">
                <assign variable="total" expression="(total + AnnualContribution) * (1 + InterestRate)"/>
                <output expression="&quot;year&quot; &amp; year &amp; &quot; Total is $ &quot; &amp; Total" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
