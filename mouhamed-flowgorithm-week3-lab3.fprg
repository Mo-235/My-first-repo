<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="mhddi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-27 02:57:28 PM"/>
        <attribute name="created" value="bWhkZGk7REVTS1RPUC1CN0c2ODRIOzIwMjYtMDktMjc7MDE6MzQ6NDggUE07MjgxOQ=="/>
        <attribute name="edited" value="bWhkZGk7REVTS1RPUC1CN0c2ODRIOzIwMjYtMDktMjc7MDI6NTc6MjggUE07MzsyOTMz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="&quot; Mouhamed Diallo, 09/26/2026. This a program that asks the user the speed limit and the driver&#8217;s speed in MPH. And it will help determine the driver's speed and how much the fine will be according to their speed over the limit."/>
            <declare name="Speedlimit" type="Integer" array="False" size=""/>
            <declare name="vehiclespeed" type="Integer" array="False" size=""/>
            <declare name="difference" type="Integer" array="False" size=""/>
            <declare name="fine" type="Integer" array="False" size=""/>
            <output expression="&quot; What is the speed limit &quot;" newline="True"/>
            <input variable="Speedlimit"/>
            <output expression="&quot; what is the vehicle speed &quot;" newline="True"/>
            <input variable="vehiclespeed"/>
            <assign variable="difference" expression="vehiclespeed - Speedlimit"/>
            <if expression="difference &lt;= 0">
                <then>
                    <output expression="&quot; there is no fine&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="difference &lt;= 9">
                        <then>
                            <output expression="&quot;The fine for driving &quot; &amp; difference &amp; &quot; MPH over the speed limit is $25&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="Difference &lt;= 19">
                                <then>
                                    <output expression="&quot;The fine for driving &quot; &amp; difference &amp; &quot; MPH over the speed limit is $50&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="difference &lt;= 29">
                                        <then>
                                            <output expression="&quot;The fine for driving &quot; &amp; difference &amp; &quot; MPH over the speed limit is $100&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <if expression="difference &lt;= 39">
                                                <then>
                                                    <output expression="&quot;The fine for driving &quot; &amp; difference &amp; &quot; MPH over the speed limit is $250&quot;" newline="True"/>
                                                </then>
                                                <else>
                                                    <output expression="&quot;The fine for driving &quot; &amp; difference &amp; &quot; MPH over the speed limit is $500&quot;" newline="True"/>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
