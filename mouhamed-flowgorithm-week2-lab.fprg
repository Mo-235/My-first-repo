    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="planet" type="String" array="False" size=""/>
            <declare name="distance" type="Real" array="False" size=""/>
            <declare name="pyears" type="Real" array="False" size=""/>
            <output expression="&quot;Enter name of the planet&quot;" newline="True"/>
            <comment text="get the planet name from the user"/>
            <input variable="planet"/>
            <comment text="Ask for distance from the sun"/>
            <output expression="&quot;Enter the distance of the planet from the sun in AU:&quot;" newline="True"/>
            <input variable="Distance"/>
            <comment text="calculate the number of eart years "/>
            <assign variable="pyears" expression="Sqrt(distance^3)"/>
            <output expression="&quot;A year on &quot; &amp; planet &amp; &quot; is: &quot; &amp; pyears &amp; &quot; Earth years. &quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
